<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection'
      xmlns='http://www.w3.org/1999/xhtml'
      xmlns:b='http://www.google.com/2005/gml/b'
      xmlns:data='http://www.google.com/2005/gml/data'
      xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type'/>
  <title><data:blog.pageTitle/></title>
  <b:include data='blog' name='all-head-content'/>
  <link href='https://fonts.googleapis.com/css2?family=DM+Mono&amp;family=Playfair+Display:ital,wght@0,600;1,600&amp;display=swap' rel='stylesheet'/>

  <b:skin><![CDATA[
    :root {
      --pink: #f4b5c5;
      --light: #fff0f3;
      --red: #a90028;
      --darkred: #590015;
      --black: #211116;
      --paper: #fff9f5;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background-color: #f8dce3;
      background-image: radial-gradient(#d88b9d .7px, transparent .7px);
      background-size: 13px 13px;
      color: var(--black);
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      cursor: crosshair;
    }
    a { color: var(--red); text-decoration: none; }
    a:hover { color: #ed4168; text-decoration: underline; }
    ::selection { background: var(--red); color: white; }

    .container {
      width: 900px;
      max-width: 95%;
      margin: 55px auto;
      background: var(--paper);
      border: 1px solid #c77c8c;
      box-shadow: 8px 8px 0 #d99aa9;
    }
    .topbar {
      background: var(--darkred);
      color: white;
      padding: 9px 15px;
      font-size: 10px;
      letter-spacing: 2px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }
    .topbar span { color: #ffb9ca; }
    .header {
      min-height: 205px;
      background:
        linear-gradient(90deg, rgba(71,0,19,.87), rgba(125,0,35,.38)),
        url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?w=1200') center/cover;
      color: white;
      padding: 40px 35px;
      position: relative;
      overflow: hidden;
    }
    .header:after {
      content: "♡";
      position: absolute;
      right: 35px;
      bottom: -60px;
      font-size: 200px;
      color: rgba(255,255,255,.13);
      pointer-events: none;
    }
    .header h1 {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-size: 46px;
      margin: 0;
      text-shadow: 2px 2px #65001a;
      position: relative;
      z-index: 1;
    }
    .header p {
      letter-spacing: 3px;
      font-size: 9px;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }
    .nav {
      background: #f5c4cf;
      border-top: 1px solid #d48c9d;
      border-bottom: 1px solid #d48c9d;
      padding: 12px;
      text-align: center;
    }
    .nav a {
      display: inline-block;
      margin: 3px 12px;
      color: #75001c;
      font-size: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .nav a:hover { color: white; }
    .content {
      display: grid;
      grid-template-columns: 230px minmax(0, 1fr);
      gap: 20px;
      padding: 22px;
    }
    .sidebar, .posts { min-width: 0; }
    .widget {
      background: white;
      border: 1px solid #e3a8b5;
      margin-bottom: 15px;
      padding: 13px;
    }
    .widget-title {
      background: #850020;
      color: white;
      padding: 8px;
      margin: -13px -13px 12px;
      text-align: center;
      font-size: 10px;
      letter-spacing: 2px;
    }
    .profile { text-align: center; }
    .profile img {
      width: 105px;
      height: 105px;
      object-fit: cover;
      border: 4px solid #f1bdc9;
      border-radius: 50%;
      padding: 3px;
      transition: .25s ease;
    }
    .profile img:hover { transform: rotate(8deg) scale(1.05); }
    .profile h2 {
      font-family: 'Playfair Display', serif;
      color: var(--red);
      font-size: 21px;
      margin: 8px 0 5px;
    }
    .profile p { line-height: 1.8; }
    .status {
      background: #fff0f3;
      padding: 9px;
      border-left: 3px solid var(--red);
      line-height: 1.8;
    }
    .status b { color: var(--red); }
    .love-list { list-style: none; padding: 0; line-height: 2.3; }
    .love-list li:before { content: "♥ "; color: var(--red); }
    .music-player {
      background: #fff0f3;
      border: 1px dashed #d48c9d;
      padding: 10px;
      text-align: center;
    }
    .music-player .song-title {
      color: var(--red);
      font-family: 'Playfair Display', serif;
      font-size: 15px;
      margin-bottom: 8px;
    }
    .music-player audio { width: 100%; height: 32px; }
    .post {
      background: white;
      border: 1px solid #e3a8b5;
      margin-bottom: 20px;
      padding: 17px;
      overflow-wrap: anywhere;
    }
    .post-title {
      font-family: 'Playfair Display', serif;
      font-size: 23px;
      font-style: italic;
      color: var(--red);
      margin: 0 0 12px;
    }
    .post-title a { color: var(--red); }
    .post-body { line-height: 1.9; }
    .post-body img, .post-body iframe, .post-body video {
      max-width: 100%;
    }
    .post-body img { height: auto; }
    .post-body blockquote {
      border-left: 3px solid #bd3152;
      margin-left: 5px;
      padding-left: 12px;
      color: #8d4054;
    }
    .post-meta {
      border-top: 1px dashed #e3a8b5;
      padding-top: 10px;
      margin-top: 15px;
      color: #a16b79;
      font-size: 9px;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 5px;
    }
    .post-meta a { margin-right: 5px; }
    .pager { text-align: center; padding: 5px 0 15px; }
    .pager a { margin: 0 12px; }
    .heart { color: var(--red); font-size: 15px; }
    .footer {
      background: var(--darkred);
      color: #ffdce4;
      padding: 17px;
      text-align: center;
      letter-spacing: 2px;
      font-size: 9px;
    }
    .blog-pager { display: none; }
    @media(max-width:650px) {
      .container { margin: 15px auto; max-width: 96%; }
      .header { padding: 35px 20px; }
      .header h1 { font-size: 34px; }
      .content { grid-template-columns: 1fr; padding: 13px; }
      .sidebar { order: 1; }
      .posts { order: 2; }
      .topbar { font-size: 8px; letter-spacing: 1px; }
    }
  ]]></b:skin>
</head>

<body>
  <div class='container'>
    <div class='topbar'>
      <span>♥ PRIVATE DIARY ♥</span>
      <span>PLEASE DON'T TELL ANYONE</span>
    </div>

    <header class='header'>
      <h1><data:blog.title/></h1>
      <p>♡ a little love never hurt anybody ♡</p>
    </header>

    <nav class='nav'>
      <a expr:href='data:blog.homepageUrl'>Home</a>
      <a expr:href='data:blog.homepageUrl + "p/about.html"'>About</a>
      <a expr:href='data:blog.homepageUrl + "search"'>Search</a>
      <a expr:href='data:blog.homepageUrl + "search/label/Diary"'>Diary</a>
      <a expr:href='data:blog.homepageUrl + "archive"'>Archive</a>
    </nav>

    <div class='content'>
      <aside class='sidebar'>
        <div class='widget profile'>
          <div class='widget-title'>♡ THE OWNER ♡</div>
          <img alt='Profile picture' src='https://file.garden/aVulH1O9NxbH0kED/%D9%AC%D9%AC%20%20%C2%A1%20%F0%9D%99%89%20%E1%B4%80%E1%B4%9Bs%E1%B4%9C%E1%B4%8B%C9%AA%20%F0%9D%99%80%20%E1%B4%87%E1%B4%85%C9%AA%E1%B4%9B!%20%20_%E1%B0%94.jpg'/>
          <h2><data:blog.title/></h2>
          <p><data:blog.description/></p>
          <div class='heart'>♥ ♥ ♥</div>
        </div>

        <div class='widget'>
          <div class='widget-title'>♡ CURRENT STATUS ♡</div>
          <div class='status'>
            <b>LOVE:</b> 100%<br/>
            <b>MOOD:</b> obsessed<br/>
            <b>THINKING ABOUT:</b> you<br/>
            <b>HEART:</b> yours
          </div>
        </div>

        <div class='widget'>
          <div class='widget-title'>♡ THINGS I LOVE ♡</div>
          <ul class='love-list'>
            <li>Pink roses</li>
            <li>Love letters</li>
            <li>Pretty ribbons</li>
            <li>Sweet memories</li>
            <li>You, obviously.</li>
          </ul>
        </div>

        <div class='widget'>
          <div class='widget-title'>♡ NOW PLAYING ♡</div>
          <div class='music-player'>
            <div class='song-title'>Britney Spears — If U Seek Amy</div>
            <audio controls='controls' preload='none'>
              <source src='https://file.garden/aVulH1O9NxbH0kED/Britney%20Spears%20-%20If%20U%20Seek%20Amy%20(Audio).mp3' type='audio/mpeg'/>
              Your browser does not support the audio player.
            </audio>
            <p>♫ a little song for you ♡</p>
          </div>
        </div>

        <div class='widget'>
          <div class='widget-title'>♡ LITTLE SECRET ♡</div>
          <div style='text-align:center;line-height:1.8;'>
            <p>&quot;If I can't have your heart, nobody can.&quot;</p>
            <span class='heart'>♡</span>
          </div>
        </div>
      </aside>

      <main class='posts'>
        <b:section class='main' id='main' showaddelement='no'>
          <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='showDateHeader'>false</b:widget-setting>
              <b:widget-setting name='showShareButtons'>true</b:widget-setting>
              <b:widget-setting name='showCommentLink'>true</b:widget-setting>
              <b:widget-setting name='showAuthor'>false</b:widget-setting>
              <b:widget-setting name='showTimestamp'>true</b:widget-setting>
              <b:widget-setting name='showLabels'>true</b:widget-setting>
              <b:widget-setting name='showLocation'>false</b:widget-setting>
              <b:widget-setting name='showPostLabels'>true</b:widget-setting>
              <b:widget-setting name='postsPerAd'>1</b:widget-setting>
              <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main'>
              <b:if cond='data:blog.pageType == "index"'>
                <b:loop values='data:posts' var='post'>
                  <article class='post'>
                    <b:if cond='data:post.title'>
                      <h2 class='post-title'>
                        <a expr:href='data:post.url'><data:post.title/></a>
                      </h2>
                    </b:if>
                    <div class='post-body'>
                      <data:post.body/>
                    </div>
                    <div class='post-meta'>
                      <span>
                        <a expr:href='data:post.url'><data:post.timestamp/></a>
                        <b:if cond='data:post.allowComments'>
                          · <a expr:href='data:post.addCommentUrl'>Comments</a>
                        </b:if>
                      </span>
                      <span>
                        <b:loop values='data:post.labels' var='label'>
                          <a expr:href='data:label.url'>#<data:label.name/></a>
                        </b:loop>
                      </span>
                    </div>
                  </article>
                </b:loop>
              <b:else/>
                <b:loop values='data:posts' var='post'>
                  <article class='post'>
                    <b:if cond='data:post.title'>
                      <h2 class='post-title'><data:post.title/></h2>
                    </b:if>
                    <div class='post-body'><data:post.body/></div>
                    <div class='post-meta'>
                      <span><data:post.timestamp/></span>
                      <span>
                        <b:loop values='data:post.labels' var='label'>
                          <a expr:href='data:label.url'>#<data:label.name/></a>
                        </b:loop>
                      </span>
                    </div>
                    <b:if cond='data:blog.pageType == "item"'>
                      <div class='comments'>
                        <b:include data='post' name='comments'/>
                      </div>
                    </b:if>
                  </article>
                </b:loop>
              </b:if>
              <div class='pager'>
                <b:if cond='data:newerPageUrl'>
                  <a expr:href='data:newerPageUrl'>← NEWER</a>
                </b:if>
                ♥ ♥ ♥
                <b:if cond='data:olderPageUrl'>
                  <a expr:href='data:olderPageUrl'>OLDER →</a>
                </b:if>
              </div>
            </b:includable>
            <b:includable id='comments' var='post'>
              <div class='comments' id='comments'>
                <h3>♡ COMMENTS ♡</h3>
                <b:if cond='data:post.allowComments'>
                  <a expr:href='data:post.addCommentUrl'>Leave a comment</a>
                </b:if>
                <b:loop values='data:post.comments' var='comment'>
                  <div class='comment-block'>
                    <b><data:comment.author/></b>
                    <p><data:comment.body/></p>
                  </div>
                </b:loop>
              </div>
            </b:includable>
          </b:widget>
        </b:section>
      </main>
    </div>

    <footer class='footer'>
      MADE WITH LOVE ♥ FOREVER AND ALWAYS
      <br/><br/>
      <data:blog.title/> © 2026
    </footer>
  </div>
</body>
</html>
